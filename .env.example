# Public URL of the site, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.co.il

# Contact form delivery. Configure ONE of the two options below.
# Without either, the form validates the request and hands the visitor over to
# WhatsApp with their details already written into the message.

# Option A: email through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "ARStudio <site@your-domain.co.il>"
CONTACT_FROM_EMAIL=

# Option B: POST the lead as JSON to any webhook (Make, Zapier, n8n, a CRM...)
CONTACT_WEBHOOK_URL=
